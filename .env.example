# Development services (docker-compose.dev.yml)
POSTGRES_DB=strife
POSTGRES_USER=strife
POSTGRES_PASSWORD=strife-dev
POSTGRES_PORT=5432
TIKA_PORT=9998

# API / worker runtime (cargo run or Compose service env)
DATABASE_URL=postgresql://strife:strife-dev@127.0.0.1:5432/strife
RUN_MIGRATIONS=true
BACKFILL_ENABLED=false
STORAGE_ROOT=./.data/storage
# One configured source root maps into the library root. Missing/unreadable
# directories disable import routes without preventing API startup.
IMPORT_WATCH_ROOT=./.data/import
LISTEN_ADDR=127.0.0.1:3000
TIKA_URL=http://127.0.0.1:9998
UPLOAD_SESSION_TTL_HOURS=24
DISK_GUARD_PERCENT=90
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_TTL_SECONDS=300
OCR_EMBEDDED_TEXT_MIN_CHARS=20
STRIFE_OCR_LANGUAGE=eng
TESSERACT_BIN=tesseract
OCR_RASTER_DPI=200
OCR_MAX_PAGES=100
OCR_MAX_PIXELS_PER_PAGE=40000000
OCR_FILE_TIMEOUT_SECONDS=600
OCR_MEMORY_LIMIT_BYTES=536870912
OCR_MAX_TEXT_BYTES=16777216
EXTRACTOR_CONCURRENCY=1
PREVIEW_CONCURRENCY=2

# Heavy extractor admission. OCR, email parsing, and attachment extraction all
# draw from one shared cross-process permit whose width is HEAVY_CPU_CONCURRENCY;
# the per-family values cap how much of it one worker process will use. All
# default to 1 on Orion, where four cores are shared with Postgres and Tika.
OCR_CONCURRENCY=1
EMAIL_PARSE_CONCURRENCY=1
ATTACHMENT_EXTRACTION_CONCURRENCY=1
HEAVY_CPU_CONCURRENCY=1

# Email parser limits. Provisional: profiled on Orion before being treated as
# final. A limit failure names the exact limit and is terminal when retrying
# could not change the outcome.
EMAIL_MAX_SOURCE_BYTES=67108864
EMAIL_MAX_BODY_BYTES=2097152
EMAIL_MAX_HEADERS=512
EMAIL_MAX_HEADER_BYTES=16384
EMAIL_MAX_PARTS=1024
EMAIL_MAX_ATTACHMENTS=256
EMAIL_MAX_WARNINGS=64
EMAIL_FILE_TIMEOUT_SECONDS=120
# Attachment materialization ceilings, applied per part and per message.
EMAIL_MAX_ATTACHMENT_BYTES=26214400
EMAIL_MAX_TOTAL_ATTACHMENT_BYTES=67108864
EMAIL_MAX_ATTACHMENT_DEPTH=1

# Job retention. The jobs table is append-only in practice — every upload,
# import, extraction, and backfill batch adds a row — so finished jobs are
# purged on a schedule. Successes are receipts nobody re-reads once the artifact
# exists; failures carry last_error and the attempt count, so they are kept
# longer for triage. Pending and leased jobs are never purged at any age.
JOB_RETENTION_COMPLETED_DAYS=7
JOB_RETENTION_FAILED_DAYS=30
JOB_PURGE_BATCH=500

RUST_LOG=info

# Frontend development proxy
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_UPLOAD_CHUNK_SIZE_BYTES=1048576
# Optional static-preview fixture; production reads usage from /api/ready.
VITE_PREVIEW_DISK_USAGE_PERCENT=

# ---------------------------------------------------------------------------
# Production LAN self-host (docker-compose.prod.yml) — required / recommended
# ---------------------------------------------------------------------------
# Required: strong password used by Postgres and embedded in service DATABASE_URL.
# POSTGRES_PASSWORD=
# Image tag for strife-api / strife-worker / strife-web (default: latest).
# STRIFE_IMAGE_TAG=latest
# Build-time revision metadata passed into Dockerfiles (optional but recommended).
# STRIFE_REVISION=unknown
# Host paths expected by compose (create before first up):
#   /srv/strife/postgres  /srv/strife/storage  /srv/strife/import
